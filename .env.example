# FinanceAI 2.0 environment configuration
# setup_windows.bat creates .env from this file on first setup.
SECRET_KEY=change-this-to-a-long-random-secret
DB_BACKEND=sqlite
SQLITE_PATH=instance/financeai.db

# Optional MySQL / XAMPP
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=financeai

# Local server
HOST=127.0.0.1
PORT=5050
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
SESSION_MINUTES=120
